# 数据库的每小时本地备份（DAT-060 至 DAT-064；阶段 5 第 7 步），由 yi-backup.timer 触发。
# 以线上版本的服务端执行 node server.cjs backup（server/db/backup.ts）：VACUUM INTO 快照、完整性检查、SHA-256，保留最新的 24 份与最近 7 天各一份。
# 结果写 db.backup-done、db.backup-skipped 或 db.backup-failed 日志（07-operations.md 第 8 节），失败为 error 级。
# 安装到 /etc/systemd/system/：npm run deploy -- install-backup（线上须为 3.0.0 或更高的版本）
[Unit]
Description=Yi hourly backup of the database
# 本地备份成功后上传异地加密备份（DAT-061 第二层，P1-13）；上传失败不影响本地备份的结果
OnSuccess=yi-offsite.service

[Service]
Type=oneshot
User=yi
Group=yi
WorkingDirectory=/var/lib/yi
ExecStart=/opt/node/bin/node /opt/yi/current/server.cjs backup
Environment=NODE_ENV=production
Environment=YI_DB=/var/lib/yi/yi.db
Environment=YI_BACKUP_DIR=/var/lib/yi/backup
TimeoutStartSec=10min
MemoryMax=256M
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/yi
