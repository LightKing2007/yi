# 独立官网与联机程序共用域名；网站部署无需重启游戏或打开其数据库。
yi.lightking.com.cn {
  @internal path /healthz /metrics /admin /admin/*
  @websocket {
    header Connection *Upgrade*
    header Upgrade websocket
  }
  # route 内按声明顺序执行：先屏蔽内部接口，再分流游戏与官网。
  route {
    respond @internal 404
    reverse_proxy @websocket 127.0.0.1:8443 {
      stream_close_delay 30m
    }
    reverse_proxy /api/* 127.0.0.1:8443
    reverse_proxy 127.0.0.1:8444
  }
}
