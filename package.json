{
  "name": "yi",
  "productName": "弈",
  "version": "2.0.4",
  "description": "弈 · 五子棋与围棋",
  "author": "LightKing",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "ratchet": "node scripts/ratchet.mjs",
    "bench": "node scripts/bench.mjs",
    "build:web": "vite build",
    "build:node": "node scripts/build-node.mjs",
    "build": "npm run typecheck && npm run build:web && npm run build:node",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "shots": "electron scripts/shots.cjs",
    "server": "node dist-server/server.cjs",
    "app": "npm run build && electron .",
    "app:dev": "npm run build:node && YI_DEV_URL=http://localhost:5173 electron .",
    "release": "node scripts/release.mjs",
    "deploy": "sh scripts/deploy.sh",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/signals": "^2.11.3",
    "@types/node": "^24.19.1",
    "@types/ws": "^8.5.0",
    "@vitest/coverage-v8": "^5.0.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "jscpd": "^5.4.0",
    "preact": "^11.0.0",
    "prettier": "^3.9.9",
    "subset-font": "^2.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "ws": "^8.18.0"
  },
  "build": {
    "appId": "com.lightking.yi",
    "productName": "弈",
    "copyright": "Copyright © 2026 LightKing. All rights reserved.",
    "directories": {
      "output": "release",
      "buildResources": "build-res"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.board-games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "darkModeSupport": true,
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "build-res/entitlements.mac.plist",
      "entitlementsInherit": "build-res/entitlements.mac.plist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Yi-${version}-win-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "弈",
      "uninstallDisplayName": "弈",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "createDesktopShortcut": true,
      "runAfterFinish": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "synopsis": "五子棋与围棋"
    },
    "asar": true,
    "artifactName": "Yi-${version}-${os}-${arch}.${ext}",
    "electronLanguages": [
      "zh_CN",
      "zh_TW",
      "en"
    ]
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
